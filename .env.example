# Same JWT secret for api-gateway, auth-service, Service-Etudiant1, and Grade-Service.
JWT_SECRET=change-me-to-a-long-shared-secret

# MySQL (auth-service and course-service)
MYSQL_USER=root
MYSQL_PASSWORD=change-me

# MongoDB (Service-Etudiant1)
MONGODB_URI=mongodb://localhost:27017/students

# First admin created by auth-service when the email does not exist yet
ADMIN_EMAIL=admin@university.local
ADMIN_PASSWORD=change-me
