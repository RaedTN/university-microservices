						"body": {
							"mode": "raw",
							"raw": "{\n  \"student_id\": 1,\n  \"course_id\": 1,\n  \"grade\": 15\n}"
						},
						"url": {
							"raw": "http://localhost:8088/grades",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8088",
							"path": [
								"grades"
							]
						},
						"description": "Create a new grade (requires JWT token)"
					}
				}
			]
		},
